# Optional `.env` — note `wrangler dev` reads secrets from `.dev.vars`
# (see `.dev.vars.example`), NOT `.env`. In production set these with
# `wrangler secret put <NAME>` — never commit real values.

# Supabase (Project settings > API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile (dash.cloudflare.com > Turnstile)
TURNSTILE_SECRET_KEY=your-turnstile-secret

# Resend (resend.com > API Keys)
RESEND_API_KEY=your-resend-api-key

# Non-secret config (also set in wrangler.jsonc "vars")
APP_URL=http://localhost:8080
NOTIFY_EMAIL_TO=info@rabbit365.co.za
EMAIL_FROM=Rabbit 365 <no-reply@emails.rabbit365.co.za>
SUPERADMIN_EMAIL=info@rabbit365.co.za
ENVIRONMENT=development
